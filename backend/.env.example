# ─── Application ──────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=3001
FRONTEND_URL=http://localhost:3000

# ─── Database ─────────────────────────────────────────────────────────────────
DATABASE_URL="postgresql://balkon:balkon_dev_password@localhost:5432/balkon_db"

# ─── JWT ──────────────────────────────────────────────────────────────────────
# Generate with: openssl rand -base64 64
JWT_ACCESS_SECRET=CHANGE_ME_ACCESS_SECRET_64_CHARS_MINIMUM
JWT_REFRESH_SECRET=CHANGE_ME_REFRESH_SECRET_64_CHARS_MINIMUM
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# ─── Security ─────────────────────────────────────────────────────────────────
MAX_LOGIN_ATTEMPTS=5

# ─── Uploads ──────────────────────────────────────────────────────────────────
MAX_FILE_SIZE_MB=10

# ─── Seed ─────────────────────────────────────────────────────────────────────
SEED_ADMIN_EMAIL=admin@balkon.cl
SEED_ADMIN_PASSWORD=Admin@Balkon2024!
